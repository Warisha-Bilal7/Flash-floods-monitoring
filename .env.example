# Copy to .env locally. Never commit .env.
# Delivery is shadow-mode (files) unless all three locks are open.

# Lock 1: delivery mode is configured in the run config (default: file).
# Lock 2:
FLOODWATCH_SEND=0

# WhatsApp Cloud API (stretch only). Leave blank unless doing a live demo.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
